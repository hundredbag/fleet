{
  "name": "fleet",
  "version": "0.1.0",
  "description": "Unified capability, configuration, and constraint manager for Claude Code, Codex, and adapter-based AI coding agents.",
  "type": "module",
  "bin": {
    "fleet": "./dist/cli/index.js",
    "fleet-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli/index.ts",
    "dev:web-fixture": "tsx tests/helpers/web-fixture-server.ts",
    "inventory": "tsx src/cli/index.ts inventory",
    "mcp": "tsx src/mcp/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "eslint src tests",
    "format": "prettier --write \"{src,tests}/**/*.ts\" \"*.{json,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\" \"*.{json,md}\" \"docs/**/*.md\"",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "claude-code",
    "codex",
    "capability-manager",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "smol-toml": "^1.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.1"
  }
}
