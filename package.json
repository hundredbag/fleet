{
  "name": "fleet",
  "version": "0.0.1",
  "description": "Unified cross-agent capability manager + discovery feed for AI agents (MCP servers / skills / rules across Claude Code, Codex, Gemini, and custom agents).",
  "type": "module",
  "bin": {
    "fleet": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli/index.ts",
    "inventory": "tsx src/cli/index.ts inventory",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
